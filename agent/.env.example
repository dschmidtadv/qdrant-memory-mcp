# AWS Credentials for Bedrock
# Required for AWS Bedrock API access
AWS_ACCESS_KEY=your-aws-access-key-here
AWS_SECRET_KEY=your-aws-secret-key-here
AWS_REGION=us-east-1
AWS_PROFILE=your-aws-profile-name

# Google AI Studio (Gemini)
# Required for Gemini API access
GEMINI_API_KEY=your-gemini-api-key-here

# OpenRouter
# Required for OpenRouter API access
OPENROUTER_API_KEY=your-openrouter-api-key-here

# LiteLLM Configuration
# Local LiteLLM proxy configuration
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=your-litellm-api-key-here

# Self-Hosted LiteLLM Configuration
# Organization-hosted LiteLLM proxy configuration
SELF_HOSTED_LITELLM_BASE_URL=https://your-proxy-domain.cloudfront.net
SELF_HOSTED_LITELLM_API_KEY=your-self-hosted-litellm-api-key-here

# OpenAI Configuration (Local LiteLLM)
# Local OpenAI-compatible endpoint
OPENAI_BASE_URL=http://localhost:3000/v1
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Configuration (Self-Hosted)
# Organization-hosted Anthropic endpoint
ANTHROPIC_BASE_URL=https://your-anthropic-endpoint.example.com/v1

# Development/Test Configuration
# Optional — only needed for local test environment overrides
# OPENAI_TEST_BASE_URL=http://localhost:4000/v1
# OPENAI_TEST_API_KEY=your-test-api-key-here
# OPENAI_TEST_MODEL_ID=dev-model-name

# AWS Bedrock Custom ARN
# Custom ARN for Bedrock inference profiles
AWS_BEDROCK_CUSTOM_ARN=arn:aws:bedrock:region:account-id:application-inference-profile/profile-id
AWS_BEDROCK_CUSTOM_ARN_HAIKU=arn:aws:bedrock:region:account-id:application-inference-profile/haiku-profile-id

# CloudFront Configuration
# Optional — not referenced by core configs; only needed for custom CDN setups
# CLOUDFRONT_DOMAIN=your-cloudfront-domain.cloudfront.net

# Developer Information
# Optional — not referenced by core configs
# DEVELOPER_ID=your-developer-id
# APP_ID=your-app-id
