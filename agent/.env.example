# AWS Credentials for Bedrock
# Required for AWS Bedrock API access
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
AWS_PROFILE=riva-profile

# Google AI Studio (Gemini)
# Required for Gemini API access
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter
# Required for OpenRouter API access
OPENROUTER_API_KEY=your_openrouter_api_key_here

# LiteLLM Configuration
# Local LiteLLM proxy configuration
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=your_litellm_api_key_here

# RIVA LiteLLM Configuration
# RIVA-hosted LiteLLM proxy configuration
RIVA_LITELLM_BASE_URL=https://d3vhktud33lq4v.cloudfront.net
RIVA_LITELLM_API_KEY=your_riva_litellm_api_key_here

# OpenAI Configuration (Local LiteLLM)
# Local OpenAI-compatible endpoint
OPENAI_BASE_URL=http://localhost:3000/v1
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Configuration (RIVA)
# RIVA-hosted Anthropic endpoint
ANTHROPIC_BASE_URL=http://reaver-ecs-kendra-lb-3636928.us-east-1.elb.amazonaws.com/v1

# Development/Test Configuration
# Development environment settings
OPENAI_TEST_BASE_URL=http://localhost:4000/v1
OPENAI_TEST_API_KEY=your_test_api_key_here
OPENAI_TEST_MODEL_ID=dev-claude

# AWS Bedrock Custom ARN
# Custom ARN for Bedrock inference profiles
AWS_BEDROCK_CUSTOM_ARN=arn:aws:bedrock:us-east-1:533267053595:application-inference-profile/0wbv40bbe9nl
AWS_BEDROCK_CUSTOM_ARN_HAIKU=arn:aws:bedrock:us-east-1:533267053595:application-inference-profile/h71b0a5ctj2w

# CloudFront Configuration
# CloudFront domain for CDN access
CLOUDFRONT_DOMAIN=d3vhktud33lq4v.cloudfront.net

# Developer Information
# Developer and application identifiers
DEVELOPER_ID=dschmidt
APP_ID=riva-roo-code
