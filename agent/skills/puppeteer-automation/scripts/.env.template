# Puppeteer Automation Environment Configuration
# Copy this file to .env in your project root and configure the values

# Base URL for testing (required)
BASE_URL=https://example.com

# Puppeteer timeout in milliseconds (default: 30000)
PUPPETEER_TIMEOUT=30000

# Browser executable path (optional - auto-detected if not set)
# macOS Chrome: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux Chromium: /usr/bin/chromium
# Windows Chrome: C:\Program Files\Google\Chrome\Application\chrome.exe
PUPPETEER_EXECUTABLE_PATH=

# WAF bypass token (only needed if testing behind a WAF that requires one)
# Contact your DevOps team for the current token
WAF_BYPASS_TOKEN=your-waf-bypass-token-here

# Comma-separated list of header names to set WAF_BYPASS_TOKEN on
# (whatever header name(s) your WAF/CDN expects)
WAF_BYPASS_HEADERS=x-waf-bypass-token

# Test configuration
TEST_HEADLESS=false
TEST_SCREENSHOTS=false
TEST_PERFORMANCE_MONITORING=false

# CI/CD specific settings
CI=false
GITHUB_ACTIONS=false

# Debug settings
DEBUG_SCREENSHOTS=false
VERBOSE_LOGGING=false